# Copy to .env and fill these on the backend machine. Never put API keys in frontend/.env.
OPENAI_API_KEY=
# Set this to a model enabled for your OpenAI API project.
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
# Optional model override; blank uses the current D: drive model path.
ROAD_SENTINEL_MODEL_PATH=
# Optional tracking overrides; configured confidence and image size are passed to model inference.
ROAD_SENTINEL_TRACK_CONFIDENCE=0.35
ROAD_SENTINEL_TRACKER_CONFIG=botsort.yaml
# Optional candidate-event heuristics. Movement is image-space only.
ROAD_SENTINEL_EVENT_MIN_DURATION_SECONDS=3.0
ROAD_SENTINEL_EVENT_STATIONARY_SPEED_PX_S=5.0
ROAD_SENTINEL_EVENT_MIN_CONFIDENCE=0.35
# Optional specialist helmet model; blank uses the configured external default.
# Set to "disabled" to skip helmet inference.
ROAD_SENTINEL_HELMET_MODEL_PATH=
ROAD_SENTINEL_HELMET_CONFIDENCE=0.65
ROAD_SENTINEL_HELMET_INFERENCE_CONFIDENCE=0.2
ROAD_SENTINEL_HELMET_FRAME_STRIDE=3
ROAD_SENTINEL_HELMET_MIN_OBSERVATIONS=3
ROAD_SENTINEL_HELMET_MIN_DURATION_SECONDS=0.5
ROAD_SENTINEL_HELMET_MIN_NO_HELMET_RATIO=0.6
